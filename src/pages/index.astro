---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconEdit from "@/assets/icons/IconEdit.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import headshot from "@/assets/images/Headshot-AlexanderJTaylor23.jpeg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b-2 border-dashed border-border"]}>
      <div class="flex flex-col items-center gap-6 text-center">
        <Image
          src={headshot}
          alt="Photo of Alexander J. Taylor"
          width={280}
          height={280}
          class="dash-border h-40 w-40 rounded-full object-cover sm:h-56 sm:w-56"
        />

        <div class="w-full">
          <h1 class="my-2 inline-block text-4xl font-bold sm:text-5xl">
            Hi, I'm Alexander.
          </h1>
          <p>
            
          </p>

          <nav aria-label="Quick links" class="mt-4">
            <ul class="flex flex-wrap justify-center gap-2">
              <li>
                <a href="/posts/" class="nav-pill">
                  <IconEdit class="h-4 w-4" />
                  My Blog
                </a>
              </li>
              <li>
                <a href="/about/" class="nav-pill">
                  <IconUser class="h-4 w-4" />
                  About Me
                </a>
              </li>
            </ul>
          </nav>

          {
            // only display if at least one social link is enabled
            SOCIALS.length > 0 && (
              <div class="mt-4 flex flex-col items-center">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/" class="nav-pill">
        All Posts
        <IconArrowRight class="inline-block h-4 w-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>