---
import { Image } from "astro:assets";
import type { Book, Film } from "../data/shelf";

interface Props {
  books: Book[];
  films: Film[];
}

const { books, films } = Astro.props;

// Sort books by author last name
const booksSorted = [...books].sort((a, b) => {
  const lastNameA = a.author.split(' ').pop() || a.author;
  const lastNameB = b.author.split(' ').pop() || b.author;
  return lastNameA.localeCompare(lastNameB);
});

// Organize films by: status (watching first) → type (show first) → alphabetically
const filmsSorted = [...films].sort((a, b) => {
  // First by status: watching comes before watched
  if (a.status !== b.status) {
    return a.status === 'watching' ? -1 : 1;
  }
  // Then by type: show comes before film
  if (a.type !== b.type) {
    return a.type === 'show' ? -1 : 1;
  }
  // Finally alphabetically by title
  return a.title.localeCompare(b.title);
});
---

<section class="shelf">
  {booksSorted.length > 0 && (
    <div class="shelf-section">
      <button
        class="shelf-heading shelf-toggle"
        aria-expanded="false"
        aria-controls="books-grid"
      >
        Books <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="books-grid" role="list" style="display:none">
        {booksSorted.map(book => (
          <li class="shelf-item">
            <div class="cover">
              {book.postSlug ? (
                <a href={`/posts/${book.postSlug}/`} title={`Read my thoughts on ${book.title}`}>
                  <Image
                    src={book.cover}
                    alt={`Cover of ${book.title}`}
                    width={240}
                    height={360}
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <Image
                  src={book.cover}
                  alt={`Cover of ${book.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="status-label">completed</span>
              {book.tags && book.tags.length > 0 && (
                <span class="type-label">{book.tags[0]}</span>
              )}
            </div>
            <p class="item-title">{book.title}</p>
            <p class="item-sub">{book.author}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  {filmsSorted.length > 0 && (
    <div class="shelf-section">
      <button
        class="shelf-heading shelf-toggle"
        aria-expanded="false"
        aria-controls="films-grid"
      >
        Films <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="films-grid" role="list" style="display:none">
        {filmsSorted.map(film => (
          <li class="shelf-item">
            <div class="cover" data-status={film.status} data-type={film.type}>
              {film.postSlug ? (
                <a href={`/posts/${film.postSlug}/`} title={`Read my thoughts on ${film.title}`}>
                  <Image
                    src={film.poster}
                    alt={`Poster for ${film.title}`}
                    width={240}
                    height={360}
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <Image
                  src={film.poster}
                  alt={`Poster for ${film.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {film.status === 'watching' && (
                <span class="status-label">watching</span>
              )}
              <span class="type-label">{film.type}</span>
            </div>
            <p class="item-title">{film.title}</p>
            <p class="item-sub">{film.year}</p>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<script>
  function initShelfToggle() {
    document.querySelectorAll('.shelf-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const gridId = btn.getAttribute('aria-controls');
        const grid = document.getElementById(gridId!);
        const arrow = btn.querySelector('.toggle-arrow');
        if (!grid || !arrow) return;

        btn.setAttribute('aria-expanded', String(!expanded));
        grid.style.display = expanded ? 'none' : 'grid';
        arrow.textContent = expanded ? '▸' : '▾';
      });
    });
  }

  initShelfToggle();
  document.addEventListener('astro:page-load', initShelfToggle);
</script>

<style>
  .shelf { margin-block: 2rem; }

  .shelf-section { margin-bottom: 3rem; }

  .shelf-heading {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .shelf-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0;
  }

  .toggle-arrow {
    font-size: 0.65rem;
    color: var(--accent);
    line-height: 1;
  }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .shelf-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cover {
    position: relative;
    width: 120px;
    height: 180px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--muted) 25%, var(--background));
  }

  .cover img,
  .cover a img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }

  .cover a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover a:hover img {
    opacity: 0.75;
  }

  .status-label {
    position: absolute;
    top: 4px;
    left: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--background);
    padding: 2px 4px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .type-label {
    position: absolute;
    bottom: 4px;
    right: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--background);
    padding: 2px 4px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .item-title {
    font-size: 0.72rem;
    font-weight: 500;
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.3;
    color: var(--foreground);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .item-sub {
    font-size: 0.65rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    margin: 0.15rem 0 0;
  }
</style>