---
import { Image } from "astro:assets";
import type { Book, Film } from "../data/shelf";

interface Props {
  books: Book[];
  films: Film[];
}

const { books, films } = Astro.props;

---

<section class="shelf">
  {films.length > 0 && (
    <div class="shelf-section">
      <h2 class="shelf-heading">Movies &amp; TV</h2>
      <ul class="shelf-grid" role="list">
        {films.map(film => (
          <li class="shelf-item">
            <div class="cover">
              {film.postSlug ? (
                <a href={`/posts/${film.postSlug}/`} title={`Read my thoughts on ${film.title}`}>
                  <Image
                    src={film.poster}
                    alt={`Poster for ${film.title}`}
                    width={120}
                    height={180}
                    format="webp"
                    quality={85}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <Image
                  src={film.poster}
                  alt={`Poster for ${film.title}`}
                  width={120}
                  height={180}
                  format="webp"
                  quality={85}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <p class="item-title">{film.title}</p>
            <p class="item-sub">{film.year}</p>
        
          </li>
        ))}
      </ul>
    </div>
  )}

  {books.length > 0 && (
    <div class="shelf-section">
      <h2 class="shelf-heading">Books</h2>
      <ul class="shelf-grid" role="list">
        {books.map(book => (
          <li class="shelf-item">
            <div class="cover">
              {book.postSlug ? (
                <a href={`/posts/${book.postSlug}/`} title={`Read my thoughts on ${book.title}`}>
                  <Image
                    src={book.cover}
                    alt={`Cover of ${book.title}`}
                    width={120}
                    height={180}
                    format="webp"
                    quality={85}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <Image
                  src={book.cover}
                  alt={`Cover of ${book.title}`}
                  width={120}
                  height={180}
                  format="webp"
                  quality={85}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <p class="item-title">{book.title}</p>
            <p class="item-sub">{book.author}</p>
            
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .shelf { margin-block: 2rem; }

  .shelf-section { margin-bottom: 3rem; }

  .shelf-heading {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .shelf-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cover {
    width: 120px;
    height: 180px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--muted) 25%, var(--background));
  }

  .cover img,
  .cover a img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }

  .cover a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover a:hover img {
    opacity: 0.75;
  }

  .item-title {
    font-size: 0.72rem;
    font-weight: 500;
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.3;
    color: var(--foreground);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .item-sub {
    font-size: 0.65rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    margin: 0.15rem 0 0;
  }
</style>