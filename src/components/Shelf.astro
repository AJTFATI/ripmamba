---
import { Image } from "astro:assets";
import type { Book, Film } from "../data/shelf";

interface Props {
  books: Book[];
  films: Film[];
}

const { books, films } = Astro.props;

const booksSorted = [...books].sort((a, b) => {
  const lastNameA = a.author.split(' ').pop() || a.author;
  const lastNameB = b.author.split(' ').pop() || b.author;
  return lastNameA.localeCompare(lastNameB);
});

const filmsSorted = [...films].sort((a, b) => {
  const statusOrder = { 'watching': 0, 'watched': 1, 'finished': 1 };
  const aOrder = statusOrder[a.status as keyof typeof statusOrder] ?? 1;
  const bOrder = statusOrder[b.status as keyof typeof statusOrder] ?? 1;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return a.title.localeCompare(b.title);
});
---

<section class="shelf">
  {booksSorted.length > 0 && (
    <div class="shelf-section">
      <button class="shelf-heading shelf-toggle" aria-expanded="false" aria-controls="books-grid">
        Books <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="books-grid" role="list" style="display:none">
        {booksSorted.map(book => (
          <li class="shelf-item">
            <button type="button" class="item-toggle" aria-expanded="false">
              <div class="cover">
                <Image
                  src={book.cover}
                  alt={`Cover of ${book.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
                {book.tags && book.tags.length > 0 && (
                  <span class="type-label">{book.tags[0]}</span>
                )}
                {book.status === 'reading' && <span class="status-label">reading</span>}
                {book.status === 'finished' && <span class="status-label">read</span>}
              </div>
              <p class="item-title">{book.title}</p>
              <p class="item-sub">{book.author}</p>
            </button>
            <div class="item-detail">
              <div class="item-detail-inner">
                <p>{book.blurb ?? 'No notes yet.'}</p>
                {book.postSlug && (
                  <a href={`/posts/${book.postSlug}/`}>Full thoughts →</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}

  {filmsSorted.length > 0 && (
    <div class="shelf-section">
      <button class="shelf-heading shelf-toggle" aria-expanded="false" aria-controls="media-grid">
        Media <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="media-grid" role="list" style="display:none">
        {filmsSorted.map(film => (
          <li class="shelf-item">
            <button type="button" class="item-toggle" aria-expanded="false">
              <div class="cover">
                <Image
                  src={film.poster}
                  alt={`Poster for ${film.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
                {film.status === 'watching' && <span class="status-label">watching</span>}
                {(film.status === 'watched' || film.status === 'finished') && (
                  <span class="status-label">watched</span>
                )}
              </div>
              <p class="item-title">{film.title}</p>
              <p class="item-sub">{film.year}</p>
            </button>
            <div class="item-detail">
              <div class="item-detail-inner">
                <p>{film.blurb ?? 'No notes yet.'}</p>
                {film.postSlug && (
                  <a href={`/posts/${film.postSlug}/`}>Full thoughts →</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="shelf-backdrop" id="shelf-backdrop" aria-hidden="true"></div>
</section>

<script>
  function initShelf() {
    const shelf = document.querySelector('.shelf');
    const backdrop = document.getElementById('shelf-backdrop');

    document.querySelectorAll('.shelf-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const grid = document.getElementById(btn.getAttribute('aria-controls')!);
        const arrow = btn.querySelector('.toggle-arrow');
        if (!grid || !arrow) return;
        btn.setAttribute('aria-expanded', String(!expanded));
        grid.style.display = expanded ? 'none' : 'grid';
        arrow.textContent = expanded ? '▸' : '▾';
      });
    });

    function closeActive() {
      document.querySelectorAll('.shelf-item.active').forEach(li => {
        li.classList.remove('active');
        li.querySelector('.item-toggle')?.setAttribute('aria-expanded', 'false');
        li.querySelector('.item-detail')?.classList.remove('open');
      });
      shelf?.classList.remove('spotlight-open');
      document.body.classList.remove('shelf-lock');
    }

    function positionDetail(anchorRect: DOMRect, inner: HTMLElement) {
      const gap = 12;
      const pad = 12;
      const innerRect = inner.getBoundingClientRect();

      const spaceBelow = window.innerHeight - anchorRect.bottom - gap - pad;
      const spaceAbove = anchorRect.top - gap - pad;

      let top = anchorRect.bottom + gap;
      if (spaceBelow < innerRect.height && spaceAbove > spaceBelow) {
        top = anchorRect.top - gap - innerRect.height;
      }
      top = Math.max(pad, Math.min(top, window.innerHeight - innerRect.height - pad));

      let left = anchorRect.left + anchorRect.width / 2 - innerRect.width / 2;
      left = Math.max(pad, Math.min(left, window.innerWidth - innerRect.width - pad));

      inner.style.top = `${top}px`;
      inner.style.left = `${left}px`;
    }

    function openItem(li: Element) {
      closeActive();
      const cover = li.querySelector('.cover') as HTMLElement | null;
      const inner = li.querySelector('.item-detail-inner') as HTMLElement | null;
      // read the rect BEFORE the scale-up transition starts, so the anchor
      // point isn't caught mid-animation
      const anchorRect = cover?.getBoundingClientRect() ?? null;

      li.classList.add('active');
      li.querySelector('.item-toggle')?.setAttribute('aria-expanded', 'true');
      li.querySelector('.item-detail')?.classList.add('open');
      shelf?.classList.add('spotlight-open');
      document.body.classList.add('shelf-lock');

      if (anchorRect && inner) positionDetail(anchorRect, inner);
    }

    window.addEventListener('resize', () => {
      const activeLi = document.querySelector('.shelf-item.active');
      const cover = activeLi?.querySelector('.cover') as HTMLElement | null;
      const inner = activeLi?.querySelector('.item-detail-inner') as HTMLElement | null;
      if (cover && inner) positionDetail(cover.getBoundingClientRect(), inner);
    });

    document.querySelectorAll('.item-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const li = btn.closest('.shelf-item');
        if (!li) return;
        li.classList.contains('active') ? closeActive() : openItem(li);
      });
    });

    // tap outside the card (anywhere in the transparent full-screen layer) closes it
    document.querySelectorAll('.item-detail').forEach(detail => {
      detail.addEventListener('click', (e) => {
        if (e.target === detail) closeActive();
      });
    });

    backdrop?.addEventListener('click', closeActive);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeActive();
    });
  }

  initShelf();
  document.addEventListener('astro:page-load', initShelf);
</script>

<style>
  .shelf { margin-block: 2rem; }
  .shelf-section { margin-bottom: 3rem; }

  .shelf-heading {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .shelf-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0;
    margin: 0 auto;
  }

  .toggle-arrow { font-size: 0.65rem; color: var(--accent); line-height: 1; }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: start;
  }

  .shelf-item {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  /* spotlight: raise the active item above the dimmed backdrop */
  .shelf-item.active { z-index: 50; }

  .item-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    transition: transform 0.25s ease;
  }

  .shelf-item.active .item-toggle {
    transform: scale(1.12);
  }

  .item-title {
    font-size: 0.65rem;
    font-weight: 500;
    margin-top: 0.4rem;
    margin-bottom: 0;
    line-height: 1.3;
    color: var(--foreground);
    width: 100%;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    padding: 0 0.1rem;
    /* reserve space for 2 lines even when the title is shorter,
       so every card in a row is the same height */
    min-height: calc(1.3em * 2);
  }

  .item-sub {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    margin: 0.15rem 0 0;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 0.1rem;
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--muted) 25%, var(--background));
    transition: opacity 0.15s, box-shadow 0.25s ease;
  }

  .item-toggle:active .cover,
  .item-toggle:hover .cover { opacity: 0.85; }

  .shelf-item.active .cover {
    opacity: 1;
    box-shadow:
      0 0 0 3px var(--accent),
      0 0 32px 4px color-mix(in srgb, var(--accent) 55%, transparent),
      0 20px 48px rgba(0, 0, 0, 0.45);
  }

  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .status-label,
  .type-label {
    position: absolute;
    font-size: 0.5rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--background);
    padding: 2px 4px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .status-label { top: 4px; left: 4px; }
  .type-label { bottom: 4px; right: 4px; }

  /* dims + blurs everything while a book is spotlighted */
  .shelf-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
    z-index: 40;
  }

  .shelf.spotlight-open .shelf-backdrop {
    opacity: 1;
    visibility: visible;
  }

  /* blurb: fixed, full-viewport, centers its card regardless of grid position */
  .item-detail {
    position: fixed;
    inset: 0;
    z-index: 60;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .item-detail.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .item-detail-inner {
    position: fixed;
    width: min(420px, calc(100vw - 1.5rem));
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1.2rem 1rem;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    transform: scale(0.94);
    transition: transform 0.25s ease;
  }

  .item-detail.open .item-detail-inner {
    transform: scale(1);
  }

  .item-detail-inner p {
    margin: 0 0 0.6rem;
    color: var(--foreground);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .item-detail-inner a {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .shelf-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }
    .item-title { font-size: 0.62rem; }
    .item-sub { display: none; }
    .shelf-item.active .item-toggle { transform: scale(1.08); }
  }

  @media (max-width: 420px) {
    .shelf-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>

<style is:global>
  /* locks background scroll while a book is spotlighted, so the sheet
     doesn't scroll behind the modal on mobile */
  body.shelf-lock {
    overflow: hidden;
  }
</style>
