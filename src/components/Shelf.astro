---
import { Image } from "astro:assets";
import type { Book, Film } from "../data/shelf";

interface Props {
  books: Book[];
  films: Film[];
}

const { books, films } = Astro.props;

const booksSorted = [...books].sort((a, b) => {
  const lastNameA = a.author.split(' ').pop() || a.author;
  const lastNameB = b.author.split(' ').pop() || b.author;
  return lastNameA.localeCompare(lastNameB);
});

const filmsSorted = [...films].sort((a, b) => {
  const statusOrder = { 'watching': 0, 'watched': 1, 'finished': 1 };
  const aOrder = statusOrder[a.status as keyof typeof statusOrder] ?? 1;
  const bOrder = statusOrder[b.status as keyof typeof statusOrder] ?? 1;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return a.title.localeCompare(b.title);
});
---

<section class="shelf">
  {booksSorted.length > 0 && (
    <div class="shelf-section">
      <button class="shelf-heading shelf-toggle" aria-expanded="false" aria-controls="books-grid">
        Books <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="books-grid" role="list" style="display:none">
        {booksSorted.map(book => (
          <li class="shelf-item">
            <button type="button" class="item-toggle" aria-expanded="false">
              <div class="cover">
                <Image
                  src={book.cover}
                  alt={`Cover of ${book.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
                {book.tags && book.tags.length > 0 && (
                  <span class="type-label">{book.tags[0]}</span>
                )}
                {book.status === 'reading' && <span class="status-label">reading</span>}
                {book.status === 'finished' && <span class="status-label">read</span>}
              </div>
              <p class="item-title">{book.title}</p>
              <p class="item-sub">{book.author}</p>
            </button>
            <div class="item-detail">
              <div class="item-detail-inner">
                <p>{book.blurb ?? 'No notes yet.'}</p>
                {book.postSlug && (
                  <a href={`/posts/${book.postSlug}/`}>Full thoughts →</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}

  {filmsSorted.length > 0 && (
    <div class="shelf-section">
      <button class="shelf-heading shelf-toggle" aria-expanded="false" aria-controls="media-grid">
        Media <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="media-grid" role="list" style="display:none">
        {filmsSorted.map(film => (
          <li class="shelf-item">
            <button type="button" class="item-toggle" aria-expanded="false">
              <div class="cover">
                <Image
                  src={film.poster}
                  alt={`Poster for ${film.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
                {film.status === 'watching' && <span class="status-label">watching</span>}
                {(film.status === 'watched' || film.status === 'finished') && (
                  <span class="status-label">watched</span>
                )}
              </div>
              <p class="item-title">{film.title}</p>
              <p class="item-sub">{film.year}</p>
            </button>
            <div class="item-detail">
              <div class="item-detail-inner">
                <p>{film.blurb ?? 'No notes yet.'}</p>
                {film.postSlug && (
                  <a href={`/posts/${film.postSlug}/`}>Full thoughts →</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<script>
  function initShelf() {
    document.querySelectorAll('.shelf-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const grid = document.getElementById(btn.getAttribute('aria-controls')!);
        const arrow = btn.querySelector('.toggle-arrow');
        if (!grid || !arrow) return;
        btn.setAttribute('aria-expanded', String(!expanded));
        grid.style.display = expanded ? 'none' : 'grid';
        arrow.textContent = expanded ? '▸' : '▾';
      });
    });

    document.querySelectorAll('.item-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const detail = btn.nextElementSibling as HTMLElement | null;
        if (!detail) return;

        // close any other open item in the same grid
        const grid = btn.closest('.shelf-grid');
        if (grid) {
          grid.querySelectorAll('.item-toggle[aria-expanded="true"]').forEach(otherBtn => {
            if (otherBtn === btn) return;
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherDetail = otherBtn.nextElementSibling as HTMLElement | null;
            otherDetail?.classList.remove('open');
          });
        }

        btn.setAttribute('aria-expanded', String(!expanded));
        detail.classList.toggle('open', !expanded);
      });
    });
  }

  initShelf();
  document.addEventListener('astro:page-load', initShelf);
</script>

<style>
  .shelf { margin-block: 2rem; }
  .shelf-section { margin-bottom: 3rem; }

  .shelf-heading {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .shelf-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0;
    margin: 0 auto;
  }

  .toggle-arrow { font-size: 0.65rem; color: var(--accent); line-height: 1; }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: start;
  }

  .shelf-item { display: flex; flex-direction: column; }

  .item-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .item-title {
    font-size: 0.65rem;
    font-weight: 500;
    margin-top: 0.4rem;
    margin-bottom: 0;
    line-height: 1.3;
    color: var(--foreground);
    width: 100%;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    padding: 0 0.1rem;
  }

  .item-sub {
    font-size: 0.6rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    margin: 0.15rem 0 0;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 0.1rem;
  }

  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--muted) 25%, var(--background));
    transition: opacity 0.15s;
  }

  .item-toggle:active .cover,
  .item-toggle:hover .cover { opacity: 0.85; }

  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .status-label,
  .type-label {
    position: absolute;
    font-size: 0.5rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--background);
    padding: 2px 4px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .status-label { top: 4px; left: 4px; }
  .type-label { bottom: 4px; right: 4px; }

  .item-detail {
    grid-column: 1 / -1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
    text-align: center;
  }

  .item-detail.open {
    grid-template-rows: 1fr;
  }

  .item-detail-inner {
    overflow: hidden;
    min-height: 0;
  }

  .item-detail.open .item-detail-inner {
    padding: 0.75rem 0.25rem 0.25rem;
  }

  .item-detail-inner p {
    margin: 0 auto 0.5rem;
    color: var(--foreground);
    font-size: 0.78rem;
    line-height: 1.6;
    max-width: 480px;
  }

  .item-detail-inner a {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .shelf-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }
    .item-title { font-size: 0.62rem; }
    .item-sub { display: none; }
  }
</style>