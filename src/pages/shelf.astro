---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import shelfData from "@data/shelf.json";

const title = "Shelf";
const description = "Books, films, and TV I've read and watched.";

type MediaType = "book" | "film" | "tv";
type StatusType = "read" | "watching" | "want";

interface ShelfItem {
  title: string;
  meta: string;
  type: MediaType;
  isbn?: string;
  cover?: string;
  rating: number;
  status: StatusType;
  review?: string;
}

// FIX 1: Sort here instead of the script tag. 
// This makes the page load instantly in the right order.
const items = (shelfData as ShelfItem[]).sort((a, b) => a.title.localeCompare(b.title));

function coverUrl(item: ShelfItem): string {
  if (item.type === "book" && item.isbn) {
    return `https://covers.openlibrary.org/b/isbn/${item.isbn}-M.jpg`;
  }
  if (item.cover) {
    // FIX 2: Auto-resize TMDB images from 1280px to 300px
    return item.cover.replace("/w1280/", "/w300/");
  }
  return "";
}

const typeLabels: Record<MediaType, string> = {
  book: "book",
  film: "film",
  tv: "tv",
};

const statusLabels: Record<StatusType, string> = {
  read: "read",
  watching: "watching",
  want: "want to",
};
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content" class="app-layout py-10">

    <div class="shelf-header">
      <h1 class="shelf-title">Shelf</h1>
      <p class="shelf-sub">{description}</p>
    </div>

    <div class="filter-bar" role="group" aria-label="Filter by media">
      <button class="filter-btn active" data-filter="all">all</button>
      <button class="filter-btn" data-filter="book">books</button>
      <button class="filter-btn" data-filter="film">films</button>
      <button class="filter-btn" data-filter="tv">tv</button>
    </div>

    <div class="shelf-grid" id="shelf-grid">
      {items.map((item, index) => {
        const cover = coverUrl(item);
        const hasReview = item.review && item.review.length > 0;
        return (
          <article class="shelf-card" data-type={item.type}>
            <div class="card-cover">
              {cover ? (
                <img
  src={cover}
  alt={`Cover of ${item.title}`}
  loading={index < 6 ? "eager" : "lazy"}
  width="200"
  height="300"
  decoding="async"
  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
/>
              ) : null}
              <div class="cover-placeholder" style={cover ? "display:none" : ""}>
                 {/* ... (Keep your SVG code here) ... */}
              </div>
              <div class={`status-pip status-${item.status}`} title={statusLabels[item.status]}></div>
            </div>

            <div class="card-body">
              <p class="card-title">{item.title}</p>
              <p class="card-meta">{item.meta}</p>
              <div class="card-footer">
                <span class={`type-badge type-${item.type}`}>{typeLabels[item.type]}</span>
                {item.status !== "want" ? (
                  <span class="stars" aria-label={`${item.rating} out of 5 stars`}>
                    {"★".repeat(item.rating)}{"☆".repeat(5 - item.rating)}
                  </span>
                ) : (
                  <span class="want-label">want to</span>
                )}
              </div>
              {hasReview && (
                <a href={item.review} class="review-link">read my notes →</a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <p class="shelf-count" id="shelf-count">{items.length} items</p>

  </main>
  <Footer />
</Layout>

<style>
  /* ... (Keep your existing styles) ... */
  
  /* ADD THIS to make scrolling 100 items smoother */
  .shelf-card {
    content-visibility: auto;
    contain-intrinsic-size: 130px 200px;
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const grid = document.getElementById("shelf-grid");
  const countEl = document.getElementById("shelf-count");

  let currentFilter = "all";

  // FIX 5: Simplified this to ONLY filter. Sorting is now handled by Astro.
  function applyFilter() {
    const cards = Array.from(grid?.querySelectorAll<HTMLElement>(".shelf-card") ?? []);
    let visible = 0;
    
    cards.forEach(card => {
      const show = currentFilter === "all" || card.dataset.type === currentFilter;
      if (show) {
        card.removeAttribute("data-hidden");
        visible++;
      } else {
        card.setAttribute("data-hidden", "");
      }
    });

    if (countEl) {
      const label = currentFilter === "all" ? "items" : currentFilter === "book" ? "books" : currentFilter === "film" ? "films" : "shows";
      countEl.textContent = `${visible} ${label}`;
    }
  }

  btns.forEach(btn => {
    btn.addEventListener("click", () => {
      btns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentFilter = btn.dataset.filter ?? "all";
      applyFilter();
    });
  });
</script>