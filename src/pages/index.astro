<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>To the Bay, with love.</title>
  </head>
  <body>
    <div class="video-wrap">
      <video autoplay muted loop playsinline class="bg-blur">
        <source src="/videos/Jul20-Zhills.mp4" type="video/mp4">
      </video>
      <video autoplay muted loop playsinline class="fg-sharp" id="main-video">
        <source src="/videos/Jul20-Zhills.mp4" type="video/mp4">
      </video>
    </div>

    <button id="sound-toggle">🔇</button>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    overflow: hidden;
    background: #000;
  }

  .video-wrap {
    position: fixed;
    inset: 0; /* shorthand for top:0; right:0; bottom:0; left:0 */
    width: 100%;
    height: 100%;
    height: 100dvh;
  }

  .bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(30px) brightness(0.6);
    transform: scale(1.1);
  }

.fg-sharp {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%) scale(1.25); /* ← tweak this */
  object-fit: cover; /* ← changed from contain */
  box-shadow: 0 0 60px rgba(0,0,0,0.5);
}
  #sound-toggle {
    position: fixed;
    bottom: calc(20px + env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(0,0,0,0.6);
    color: white;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  #sound-toggle:active {
    background: rgba(0,0,0,0.8);
  }
</style>

<script>
  const mainVideo = document.getElementById('main-video') as HTMLVideoElement;
  const btn = document.getElementById('sound-toggle') as HTMLButtonElement;

  btn.addEventListener('click', () => {
    mainVideo.muted = !mainVideo.muted;
    btn.textContent = mainVideo.muted ? '🔇' : '🔊';
  });
</script>