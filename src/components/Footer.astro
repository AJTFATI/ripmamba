---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout mx-auto w-full max-w-3xl px-4", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="my-2 flex flex-col items-center justify-center gap-2 text-center sm:flex-row sm:justify-between sm:text-left">
    © {currentYear} || <Socials />
  </div>
</footer>
