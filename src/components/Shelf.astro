---
import { Image } from "astro:assets";
import type { Book, Film } from "../data/shelf";

interface Props {
  books: Book[];
  films: Film[];
}

const { books, films } = Astro.props;

// Sort books by author last name
const booksSorted = [...books].sort((a, b) => {
  const lastNameA = a.author.split(' ').pop() || a.author;
  const lastNameB = b.author.split(' ').pop() || b.author;
  return lastNameA.localeCompare(lastNameB);
});

// Organize films by: status (watching first) → mediaType (show first) → alphabetically
const filmsSorted = [...films].sort((a, b) => {
  // First by status: watching comes before finished, finished before watched
  const statusOrder = { 'watching': 0, 'finished': 1, 'watched': 2 };
  if (a.status !== b.status) {
    return (statusOrder[a.status as keyof typeof statusOrder] || 2) - (statusOrder[b.status as keyof typeof statusOrder] || 2);
  }
  // Then by mediaType: show comes before movie
  if (a.mediaType !== b.mediaType) {
    return a.mediaType === 'show' ? -1 : 1;
  }
  // Finally alphabetically by title
  return a.title.localeCompare(b.title);
});

// Separate shows and movies
const shows = filmsSorted.filter(f => f.mediaType === 'show');
const movies = filmsSorted.filter(f => f.mediaType === 'movie');
---

<section class="shelf">
  {booksSorted.length > 0 && (
    <div class="shelf-section">
      <button
        class="shelf-heading shelf-toggle"
        aria-expanded="false"
        aria-controls="books-grid"
      >
        Books <span class="toggle-arrow">▸</span>
      </button>
      <ul class="shelf-grid" id="books-grid" role="list" style="display:none">
        {booksSorted.map(book => (
          <li class="shelf-item">
            <div class="cover">
              {book.postSlug ? (
                <a href={`/posts/${book.postSlug}/`} title={`Read my thoughts on ${book.title}`}>
                  <Image
                    src={book.cover}
                    alt={`Cover of ${book.title}`}
                    width={240}
                    height={360}
                    format="webp"
                    quality={90}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <Image
                  src={book.cover}
                  alt={`Cover of ${book.title}`}
                  width={240}
                  height={360}
                  format="webp"
                  quality={90}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {book.tags && book.tags.length > 0 && (
                <span class="type-label">{book.tags[0]}</span>
              )}
              {book.status === 'reading' && (
                <span class="status-label">reading</span>
              )}
            </div>
            <p class="item-title">{book.title}</p>
            <p class="item-sub">{book.author}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  {(shows.length > 0 || movies.length > 0) && (
    <div class="shelf-section">
      <button
        class="shelf-heading shelf-toggle"
        aria-expanded="false"
        aria-controls="media-grid"
      >
        Media <span class="toggle-arrow">▸</span>
      </button>
      
      {shows.length > 0 && (
        <div class="media-subsection">
          <h3 class="media-subheading">TV Shows</h3>
          <ul class="shelf-grid" id="shows-grid" role="list">
            {shows.map(show => (
              <li class="shelf-item">
                <div class="cover" data-status={show.status} data-type={show.mediaType}>
                  {show.postSlug ? (
                    <a href={`/posts/${show.postSlug}/`} title={`Read my thoughts on ${show.title}`}>
                      <Image
                        src={show.poster}
                        alt={`Poster for ${show.title}`}
                        width={240}
                        height={360}
                        format="webp"
                        quality={90}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ) : (
                    <Image
                      src={show.poster}
                      alt={`Poster for ${show.title}`}
                      width={240}
                      height={360}
                      format="webp"
                      quality={90}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {show.status === 'watching' && (
                    <span class="status-label">watching</span>
                  )}
                  {show.status === 'reading' && (
                    <span class="status-label">reading</span>
                  )}
                  <span class="type-label">{show.mediaType}</span>
                </div>
                <p class="item-title">{show.title}</p>
                <p class="item-sub">{show.year}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {movies.length > 0 && (
        <div class="media-subsection">
          <h3 class="media-subheading">Movies</h3>
          <ul class="shelf-grid" id="movies-grid" role="list">
            {movies.map(movie => (
              <li class="shelf-item">
                <div class="cover" data-status={movie.status} data-type={movie.mediaType}>
                  {movie.postSlug ? (
                    <a href={`/posts/${movie.postSlug}/`} title={`Read my thoughts on ${movie.title}`}>
                      <Image
                        src={movie.poster}
                        alt={`Poster for ${movie.title}`}
                        width={240}
                        height={360}
                        format="webp"
                        quality={90}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ) : (
                    <Image
                      src={movie.poster}
                      alt={`Poster for ${movie.title}`}
                      width={240}
                      height={360}
                      format="webp"
                      quality={90}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {movie.status === 'watching' && (
                    <span class="status-label">watching</span>
                  )}
                  {movie.status === 'reading' && (
                    <span class="status-label">reading</span>
                  )}
                  <span class="type-label">{movie.mediaType}</span>
                </div>
                <p class="item-title">{movie.title}</p>
                <p class="item-sub">{movie.year}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      <ul class="shelf-grid" id="media-grid" role="list" style="display:none"></ul>
    </div>
  )}
</section>

<script>
  function initShelfToggle() {
    document.querySelectorAll('.shelf-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const gridId = btn.getAttribute('aria-controls');
        const grid = document.getElementById(gridId!);
        const arrow = btn.querySelector('.toggle-arrow');
        const subsections = btn.nextElementSibling?.parentElement?.querySelectorAll('.media-subsection');
        
        if (!grid || !arrow) return;

        btn.setAttribute('aria-expanded', String(!expanded));
        grid.style.display = expanded ? 'none' : 'grid';
        
        // Show/hide media subsections when toggling Media section
        if (subsections) {
          subsections.forEach(subsection => {
            (subsection as HTMLElement).style.display = expanded ? 'none' : 'block';
          });
        }
        
        arrow.textContent = expanded ? '▸' : '▾';
      });
    });
  }

  initShelfToggle();
  document.addEventListener('astro:page-load', initShelfToggle);
</script>

<style>
  .shelf { margin-block: 2rem; }

  .shelf-section { margin-bottom: 3rem; }

  .shelf-heading {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .shelf-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0;
    margin: 0 auto;
  }

  .toggle-arrow {
    font-size: 0.65rem;
    color: var(--accent);
    line-height: 1;
  }

  .media-subsection {
    margin-bottom: 2rem;
  }

  .media-subheading {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    text-align: center;
    margin-top: 0;
  }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .shelf-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cover {
    position: relative;
    width: 120px;
    height: 180px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--muted) 25%, var(--background));
  }

  .cover img,
  .cover a img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s;
  }

  .cover a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover a:hover img {
    opacity: 0.75;
  }

  .status-label {
    position: absolute;
    top: 4px;
    left: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--background);
    padding: 2px 4px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .type-label {
    position: absolute;
    bottom: 4px;
    right: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    background: var(--accent);
    color: var(--background);
    padding: 2px 4px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .item-title {
    font-size: 0.72rem;
    font-weight: 500;
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.3;
    color: var(--foreground);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    padding: 0 0.25rem;
  }

  .item-sub {
    font-size: 0.65rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    margin: 0.15rem 0 0;
  }
</style>
